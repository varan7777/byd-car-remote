# Real secrets are private. Production reads /etc/varan-hub.env (0600).
NODE_ENV=production
PUBLIC_URL=https://varan.team
PORT=8080
SESSION_SECRET=replace-with-at-least-32-random-characters
WEBHOOK_SECRET=replace-with-a-different-random-secret
# Car bot. Its webhook is registered separately, never on startup.
BOT_TOKEN=
# B2Bell main bot: used only to SEND login codes, never to receive updates.
AUTH_BOT_TOKEN=
# Positive numeric ID of the owner's PRIVATE chat, never a group or browser input.
ADMIN_CHAT_ID=
# Same acquiring merchant as B2Bell, explicitly requested by the owner.
MONO_TOKEN=
DB_PATH=/var/lib/varan-hub/hub.db
MEDIA_ROOT=/var/lib/varan-hub/media
# Only actual reverse proxy addresses. Never "true" or an arbitrary hop count.
TRUSTED_PROXIES=loopback
# Optional local preview only:
# SITE_ROOT=/absolute/path/to/Varan team/public
