# Copy to .env and fill in. Never commit the real .env.

# The ONE Telegram bot token (@Varanbyd_bot). Lives ONLY here on the server — never in the APK.
BOT_TOKEN=123456:your-bot-token

# Public base URL (for the Telegram webhook). Apache reverse-proxies /tg/* to this app.
PUBLIC_URL=https://varan.team

# Local port the app listens on (Apache proxies to it; not exposed directly).
PORT=8080

# Admin panel password (basic protection for /admin).
ADMIN_PASSWORD=change-me

# Where the SQLite file lives.
DB_PATH=./data/hub.db
